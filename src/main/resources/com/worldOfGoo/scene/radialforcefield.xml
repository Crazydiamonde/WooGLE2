<AttributeManifest localName="radialforcefield">

    <attributes>
        <EditorAttribute name="id"                        type="STRING"                             required="true"/>
        <EditorAttribute name="type"                      type="STRING"      defaultValue="gravity" required="true"/>
        <EditorAttribute name="center"                    type="_1_POSITION" defaultValue="0,0"     required="true"/>
        <EditorAttribute name="radius"                     type="_1_NUMBER"  defaultValue="100"     required="true"/>
        <EditorAttribute name="forceatcenter"             type="_1_NUMBER"   defaultValue="0"       required="true"/>
        <EditorAttribute name="forceatedge"               type="_1_NUMBER"   defaultValue="0"       required="true"/>
        <EditorAttribute name="dampeningfactor"           type="_1_NUMBER"   defaultValue="0"       required="true"/>
        <EditorAttribute name="rotationaldampeningfactor" type="_1_NUMBER"/>
        <EditorAttribute name="antigrav"                  type="BOOLEAN"     defaultValue="false"   required="true"/>
        <EditorAttribute name="geomonly"                  type="BOOLEAN"                            required="true"/>
        <EditorAttribute name="enabled"                   type="BOOLEAN"     defaultValue="true"    required="true"/>
    </attributes>

    <metaAttributes>
        <MetaEditorAttribute name="id"/>
        <MetaEditorAttribute name="center"/>
        <MetaEditorAttribute name="radius"/>
        <MetaEditorAttribute name="Force Field" openByDefault="true">
            <MetaEditorAttribute name="type"/>
            <MetaEditorAttribute name="forceatcenter"/>
            <MetaEditorAttribute name="forceatedge"/>
            <MetaEditorAttribute name="dampeningfactor"/>
            <MetaEditorAttribute name="rotationaldampeningfactor"/>
            <MetaEditorAttribute name="antigrav"/>
            <MetaEditorAttribute name="geomonly"/>
            <MetaEditorAttribute name="enabled"/>
        </MetaEditorAttribute>
    </metaAttributes>

</AttributeManifest>