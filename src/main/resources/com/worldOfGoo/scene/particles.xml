<AttributeManifest localName="particles">

    <attributes>
        <EditorAttribute name="effect"  type="_1_PARTICLES"                    required="true"/>
        <EditorAttribute name="depth"   type="_1_NUMBER"    defaultValue="-20" required="true"/>
        <EditorAttribute name="pos"     type="_1_POSITION"  defaultValue="0,0"/>
        <EditorAttribute name="pretick" type="_1_NUMBER"    defaultValue="0"/>
        <EditorAttribute name="enabled" type="BOOLEAN"/>
    </attributes>

    <metaAttributes>
        <MetaEditorAttribute name="effect"/>
        <MetaEditorAttribute name="pos"/>
        <MetaEditorAttribute name="depth"/>
        <MetaEditorAttribute name="pretick"/>
        <MetaEditorAttribute name="enabled"/>
    </metaAttributes>

</AttributeManifest>