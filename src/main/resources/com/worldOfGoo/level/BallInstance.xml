<AttributeManifest localName="BallInstance">

    <attributes>
        <EditorAttribute name="type"       type="_1_BALL"                                  required="true"/>
        <EditorAttribute name="x"          type="_1_NUMBER"                                required="true"/>
        <EditorAttribute name="y"          type="_1_NUMBER"                                required="true"/>
        <EditorAttribute name="id"         type="_1_UNIQUE_GOOBALL_ID"                     required="true"/>
        <EditorAttribute name="discovered" type="BOOLEAN"              defaultValue="true"                />
        <EditorAttribute name="angle"      type="_1_NUMBER"            defaultValue="0"    required="true"/>
    </attributes>

    <metaAttributes>
        <MetaEditorAttribute name="type"/>
        <MetaEditorAttribute name="x"/>
        <MetaEditorAttribute name="y"/>
        <MetaEditorAttribute name="id"/>
        <MetaEditorAttribute name="discovered"/>
        <MetaEditorAttribute name="angle"/>
    </metaAttributes>

</AttributeManifest>