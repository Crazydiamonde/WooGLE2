<AttributeManifest localName="BallInstance">

    <attributes>
        <EditorAttribute name="typeEnum" type="_2_BALL_TYPE"/>
        <EditorAttribute name="uid" type="_2_UID"/>
        <EditorAttribute name="pos" type="_2_CHILD_HIDDEN" childAlias="com.worldOfGoo2.misc.Point"/>
        <EditorAttribute name="angle" type="NUMBER"/>
        <EditorAttribute name="terrainGroup" type="_2_TERRAIN_GROUP_TYPE_INDEX" defaultValue="-1" required="true"/>
        <EditorAttribute name="discovered" type="BOOLEAN" defaultValue="true"/>
        <EditorAttribute name="floatingWhileAsleep" type="BOOLEAN"/>
        <EditorAttribute name="interactive" type="BOOLEAN"/>
        <EditorAttribute name="wakeWithLiquid" type="BOOLEAN"/>
        <EditorAttribute name="exitPipeAlert" type="BOOLEAN"/>
        <EditorAttribute name="affectsAutoBounds" type="BOOLEAN"/>
        <EditorAttribute name="launcherLifespanMin" type="NUMBER"/>
        <EditorAttribute name="launcherLifespanMax" type="NUMBER"/>
        <EditorAttribute name="launcherForceFactor" type="NUMBER"/>
        <EditorAttribute name="launcherCanUseBalls" type="BOOLEAN"/>
        <EditorAttribute name="launcherKnockbackFactor" type="NUMBER"/>
        <EditorAttribute name="launcherMaxActive" type="NUMBER"/>
        <EditorAttribute name="launcherBallTypeToGenerate" type="_2_BALL_TYPE"/>
        <EditorAttribute name="thrustForce" type="NUMBER"/>
        <EditorAttribute name="maxVelocity" type="NUMBER"/>
        <EditorAttribute name="stiffness" type="NUMBER"/>
        <EditorAttribute name="filled" type="BOOLEAN"/>
        <EditorAttribute name="detonationRadius" type="NUMBER"/>
        <EditorAttribute name="detonationForce" type="NUMBER"/>
    </attributes>

    <metaAttributes>
        <MetaEditorAttribute name="typeEnum"/>
        <MetaEditorAttribute name="uid"/>
        <MetaEditorAttribute name="pos"/>
        <MetaEditorAttribute name="angle"/>
        <MetaEditorAttribute name="discovered"/>
        <MetaEditorAttribute name="terrainGroup"/>
        <MetaEditorAttribute name="Interactions" openByDefault="false">
            <MetaEditorAttribute name="floatingWhileAsleep"/>
            <MetaEditorAttribute name="interactive"/>
            <MetaEditorAttribute name="wakeWithLiquid"/>
            <MetaEditorAttribute name="exitPipeAlert"/>
            <MetaEditorAttribute name="affectsAutoBounds"/>
        </MetaEditorAttribute>
        <MetaEditorAttribute name="Properties" openByDefault="false">
            <MetaEditorAttribute name="thrustForce"/>
            <MetaEditorAttribute name="maxVelocity"/>
            <MetaEditorAttribute name="stiffness"/>
            <MetaEditorAttribute name="filled"/>
            <MetaEditorAttribute name="detonationRadius"/>
            <MetaEditorAttribute name="detonationForce"/>
        </MetaEditorAttribute>
        <MetaEditorAttribute name="Launcher Settings" openByDefault="false">
            <MetaEditorAttribute name="launcherLifespanMin"/>
            <MetaEditorAttribute name="launcherLifespanMax"/>
            <MetaEditorAttribute name="launcherForceFactor"/>
            <MetaEditorAttribute name="launcherCanUseBalls"/>
            <MetaEditorAttribute name="launcherKnockbackFactor"/>
            <MetaEditorAttribute name="launcherMaxActive"/>
            <MetaEditorAttribute name="launcherBallTypeToGenerate"/>
        </MetaEditorAttribute>
    </metaAttributes>

</AttributeManifest>